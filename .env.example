# Shared passcode crews type once on each phone. Leave unset only for local testing.
APP_PASSCODE=

# Shown on the customer page and burned into the share image.
BUSINESS_NAME=
# Instagram handle without the @, burned into the share image. Optional.
INSTAGRAM_HANDLE=

# Set automatically when you connect a Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=
# "private" (default) or "public": must match the access setting of your Blob store.
BLOB_ACCESS=private
